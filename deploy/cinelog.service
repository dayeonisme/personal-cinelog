[Unit]
Description=CINELOG (gunicorn)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__APPDIR__
Environment=FLASK_DEBUG=0
# Tailscale IP(100.x.x.x)에만 바인딩한다. 공개 인터페이스(외부 IP)에는 절대 뜨지 않음.
# Tailscale 이 아직 안 올라와 IP 가 없으면 공개로 새지 않도록 그냥 종료(fail-closed) →
# Restart=always 가 3초 뒤 재시도. e2-micro RAM 1GB 절약 위해 워커 1개.
ExecStart=/bin/sh -c 'TSIP="$(tailscale ip -4 | head -n1)"; [ -n "$TSIP" ] || { echo "tailscale IP 없음 — 공개 바인딩 방지 위해 종료"; exit 1; }; exec __APPDIR__/.venv/bin/gunicorn -b "$TSIP:5001" -w 1 --timeout 60 app:app'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
