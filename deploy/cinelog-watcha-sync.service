[Unit]
Description=Cinelog WatchaPedia 일일 동기화 (export -> import)
After=network-online.target tailscaled.service cinelog.service
Wants=network-online.target
# 실패 시 알림 유닛 실행 (OnFailure 는 [Unit] 섹션이어야 함)
OnFailure=cinelog-watcha-sync-failed.service

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__APPDIR__
# 자격증명/세션은 ExecStart 가 읽는 ~/.cinelog-watcha.env + watcha_state.json 에 있음.
ExecStart=__APPDIR__/deploy/watcha-sync.sh
# e2-micro(1GB) 보호: 하드킬 대신 소프트 한계 → headful Chromium 은 swap 으로 흘려보냄(4am 이라 OK).
MemoryHigh=750M
TimeoutStartSec=600
